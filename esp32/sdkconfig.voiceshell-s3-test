# Minimal pairing-only test overlay for the user-connected S3 board.
# Chip/flash/PSRAM facts: real esptool probe on 2026-10-03:
# ESP32-S3 revision 0.2, quad 3.3 V flash 16 MB, embedded octal PSRAM 8 MB.
# BOOT pin: Espressif ESP32-S3 boot-mode documentation, GPIO0;
# user successfully entered ROM download mode with BOOT + RESET.
# Exact board vendor/model and peripheral pin map remain unknown.
# No LED, display, microphone, speaker or home-network tunnel is enabled.
# Load after the pinned upstream esp32/sdkconfig.defaults.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_HOMEHUB_BUTTON_GPIO=0
CONFIG_HOMEHUB_LED_BACKEND_DEVKIT_GPIO27=n
CONFIG_HOMEHUB_LED_BACKEND_NONE=y
CONFIG_HOMEHUB_OTA_ENABLED=n
CONFIG_HOMEHUB_SUPPORT_BUG_REPORT=n
CONFIG_HOMEHUB_TUNNEL=n
CONFIG_ESPTOOLPY_FLASHMODE_QIO=n
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=n
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=n
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_SECURE_BOOT=n
CONFIG_SECURE_FLASH_ENC_ENABLED=n
CONFIG_HOMEHUB_PAIRING_EFUSE_AUTH=n

diff --git a/esp32/main/serial_chat.c b/esp32/main/serial_chat.c
new file mode 100644
index 0000000..93c284e
--- /dev/null
+++ b/esp32/main/serial_chat.c
@@ -0,0 +1,166 @@
+/* VoiceShell headless USB text bridge. No credential export or setup writes. */
+#include "serial_chat.h"
+#include "noise_control.h"
+#include "identity.h"
+#include "cJSON.h"
+#include "driver/usb_serial_jtag.h"
+#include "esp_heap_caps.h"
+#include "esp_log.h"
+#include "esp_random.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/semphr.h"
+#include "freertos/task.h"
+#include "mbedtls/base64.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <inttypes.h>
+
+#define BODY_CAP 16384
+#define LINE_CAP 2048
+static SemaphoreHandle_t s_lock;
+static char *s_body;
+static size_t s_len;
+static uint32_t s_gen;
+static int s_status;
+static bool s_done, s_overflow;
+static char s_expected[65], s_reply[1025];
+
+bool serial_chat_receive(const char *correlation, const char *text)
+{
+    if (!s_lock || !correlation || !text || !text[0] || strlen(text) > 1024) return false;
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    bool ok = s_expected[0] && !strcmp(s_expected, correlation);
+    if (ok && s_reply[0]) ok = !strcmp(s_reply, text);
+    if (ok) strlcpy(s_reply, text, sizeof(s_reply));
+    xSemaphoreGive(s_lock);
+    return ok;
+}
+
+static void received(void *ctx, int status, const uint8_t *data, size_t len, bool end)
+{
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    if ((uint32_t)(uintptr_t)ctx == s_gen) {
+        if (status) s_status = status;
+        if (len > BODY_CAP - s_len) s_overflow = true;
+        else if (!s_overflow && len) { memcpy(s_body + s_len, data, len); s_len += len; }
+        if (end || status < 0) s_done = true;
+    }
+    xSemaphoreGive(s_lock);
+}
+
+static void request(const char *verb, const char *path, const char *body)
+{
+    if (!noise_ctrl_is_connected()) { puts("@vs_error offline"); return; }
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    if (++s_gen == 0) ++s_gen;
+    uint32_t gen = s_gen;
+    s_len = 0; s_status = 0; s_done = false; s_overflow = false;
+    xSemaphoreGive(s_lock);
+    char id[40];
+    snprintf(id, sizeof(id), "%08" PRIx32 "-%04x-4%03x-8%03x-%08" PRIx32 "%04x",
+             esp_random(), (unsigned)(esp_random() & 65535), (unsigned)(esp_random() & 4095),
+             (unsigned)(esp_random() & 4095), esp_random(), (unsigned)(esp_random() & 65535));
+    const char *headers[] = {"Content-Type", "application/json", "x-app-id", "musegadget", "x-request-id", id, NULL};
+    int64_t stream = noise_ctrl_req_open(verb, path, headers, body == NULL, received, (void *)(uintptr_t)gen);
+    if (!stream) { puts("@vs_error request_not_started"); return; }
+    bool queued = !body || noise_ctrl_req_send(stream, body, strlen(body), true, 1000);
+    bool done = false;
+    TickType_t start = xTaskGetTickCount();
+    while (queued && (xTaskGetTickCount() - start) < pdMS_TO_TICKS(90000)) {
+        xSemaphoreTake(s_lock, portMAX_DELAY);
+        done = s_done;
+        xSemaphoreGive(s_lock);
+        if (done) break;
+        vTaskDelay(pdMS_TO_TICKS(20));
+    }
+    xSemaphoreTake(s_lock, portMAX_DELAY);
+    ++s_gen; /* late callbacks cannot modify the body during serialization */
+    xSemaphoreGive(s_lock);
+    if (!queued || !done) {
+        noise_ctrl_req_cancel(stream);
+        puts("@vs_error request_timeout_or_send_failed_delivery_unknown");
+        return; /* do not retry a POST automatically */
+    }
+    if (s_overflow) { puts("@vs_error response_too_large"); return; }
+    size_t cap = 4 * ((s_len + 2) / 3) + 1, out_len = 0;
+    unsigned char *encoded = heap_caps_malloc(cap, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!encoded) { puts("@vs_error no_memory"); return; }
+    if (mbedtls_base64_encode(encoded, cap, &out_len, (const unsigned char *)s_body, s_len) == 0) {
+        encoded[out_len] = 0;
+        printf("@vs_reply {\"status\":%d,\"body_b64\":\"%s\"}\n", s_status, encoded);
+    }
+    free(encoded);
+}
+
+static void command(char *line)
+{
+    if (!strcmp(line, ">status")) {
+        printf("@vs_status {\"chat\":true,\"connected\":%s}\n", noise_ctrl_is_connected() ? "true" : "false");
+    } else if (!strncmp(line, ">expect=", 8) && line[8] && strlen(line + 8) <= 64
+               && strspn(line + 8, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-") == strlen(line + 8)) {
+        xSemaphoreTake(s_lock, portMAX_DELAY);
+        strlcpy(s_expected, line + 8, sizeof(s_expected)); s_reply[0] = 0;
+        xSemaphoreGive(s_lock);
+        puts("@vs_status {\"waiting\":true}");
+    } else if (!strcmp(line, ">reply")) {
+        cJSON *reply = cJSON_CreateObject();
+        if (!reply) { puts("@vs_error no_memory"); return; }
+        xSemaphoreTake(s_lock, portMAX_DELAY);
+        cJSON_AddStringToObject(reply, "correlation", s_expected);
+        cJSON_AddStringToObject(reply, "text", s_reply);
+        xSemaphoreGive(s_lock);
+        char *json = cJSON_PrintUnformatted(reply);
+        cJSON_Delete(reply);
+        if (json) { printf("@vs_status %s\n", json); cJSON_free(json); }
+    } else if (!strncmp(line, ">chat=", 6) && line[6]) {
+        cJSON *root = cJSON_CreateObject();
+        if (!root) { puts("@vs_error no_memory"); return; }
+        cJSON_AddStringToObject(root, "message", line + 6);
+        cJSON_AddStringToObject(root, "output_modality", "text");
+        cJSON_AddStringToObject(root, "device_id", identity_node_id());
+        char *body = cJSON_PrintUnformatted(root);
+        cJSON_Delete(root);
+        if (body) { request("POST", "/chat/stream", body); cJSON_free(body); }
+        else puts("@vs_error no_memory");
+    } else if (!strcmp(line, ">history=latest")) {
+        request("GET", "/chat/history?limit=1", NULL);
+    } else if (!strncmp(line, ">history=", 9) && line[9] && strspn(line + 9, "0123456789") == strlen(line + 9) && strlen(line + 9) <= 20) {
+        char path[96];
+        snprintf(path, sizeof(path), "/chat/history?limit=1&after_seq=%s", line + 9);
+        request("GET", path, NULL);
+    } else puts("@vs_error unsupported_command");
+    fflush(stdout);
+}
+
+static void console_task(void *unused)
+{
+    char *line = heap_caps_malloc(LINE_CAP, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!line) { vTaskDelete(NULL); return; }
+    size_t n = 0; bool overflow = false;
+    for (;;) {
+        uint8_t c;
+        if (usb_serial_jtag_read_bytes(&c, 1, pdMS_TO_TICKS(1000)) != 1) continue;
+        if (c == '\r') continue;
+        if (c == '\n') {
+            if (overflow) { puts("@vs_error line_too_long"); fflush(stdout); }
+            else if (n) { line[n] = 0; command(line); }
+            n = 0; overflow = false;
+        } else if (!c || n >= LINE_CAP - 1) overflow = true;
+        else if (!overflow) line[n++] = (char)c;
+    }
+}
+
+void serial_chat_start(void)
+{
+    s_lock = xSemaphoreCreateMutex();
+    s_body = heap_caps_malloc(BODY_CAP, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!s_lock || !s_body) { ESP_LOGE("link.serial_chat", "memory unavailable"); return; }
+    usb_serial_jtag_driver_config_t cfg = USB_SERIAL_JTAG_DRIVER_CONFIG_DEFAULT();
+    cfg.rx_buffer_size = 4096;
+    if (usb_serial_jtag_driver_install(&cfg) != ESP_OK) { ESP_LOGE("link.serial_chat", "USB console unavailable"); return; }
+    if (xTaskCreate(console_task, "vs_chat", 6144, NULL, 4, NULL) != pdPASS) {
+        ESP_LOGE("link.serial_chat", "task allocation failed"); return;
+    }
+    ESP_LOGI("link.serial_chat", "headless USB text bridge ready");
+}
